// Markdown の検査設定。
//
// 目的は主に MD040（フェンスの言語指定）です。PR #546 で 14 箇所に
// 言語を付けましたが、検査が無いと外れても誰も気づきません。
//
// 既定を有効にしたうえで、このリポジトリの既存スタイルと衝突する
// ものだけを切っています。理由を書いてあるのは、次に見た人が
// 「なぜ切ってあるのか」を判断できるようにするためです。
{
    "config": {
        // MD013（行長 80）を切る理由:
        // wp post list --post_type=... のように、折り返すと
        // コピーできなくなるコマンドがある。散文の折り返しは
        // 別途 80 桁前後で揃えているが、機械で強制はしない。
        "MD013": false,

        // MD030（リスト記号の後の空白）を切る理由:
        // このリポジトリの Markdown は @wordpress/prettier-config で
        // 整形されてきたため "-   " （3 スペース）で揃っている。
        // MD030 の既定は 1 スペースなので、有効にすると既存の
        // 全リストが違反になり、直すと整形と食い違う。
        // なお PR #546 以降 .prettierignore が *.md を除外したため、
        // Markdown は Prettier の対象外になっている。
        "MD030": false
    },
    "globs": ["**/*.md"],
    "ignores": [
        "node_modules/**",
        "vendor/**",
        "library/**",
        "temp/**",
        "build/**"
    ]
}
